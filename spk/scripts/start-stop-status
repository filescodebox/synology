#!/bin/sh
# start-stop-status —— 套件生命周期:start/stop/status(+log 供 synopkg log)
# 编排:compose.yml 随包装入 SYNOPKG_PKGDEST(升级随包更新);
#       .env 在 SYNOPKG_PKGVAR(@appdata,升级/重装保留)。
PKG="pigeonbox"
# SYNOPKG_DOCKER_BIN 仅供测试注入 mock(DSM 运行环境不会设置此变量)
DOCKER="${SYNOPKG_DOCKER_BIN:-/usr/local/bin/docker}"
[ -x "$DOCKER" ] || DOCKER="$(command -v docker 2>/dev/null)"
if [ -z "$DOCKER" ]; then
    [ "$1" = "status" ] && exit 4
    echo "未找到 docker 命令" >&2
    exit 1
fi

PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
COMPOSE_FILE="${PKGDEST}/compose.yml"
ENV_FILE="${PKGVAR}/.env"
LOG_FILE="${PKGVAR}/pigeonbox.log"

compose() {
    # -p 固定项目名,保证容器/网络命名稳定,与 Container Manager 手工项目隔离
    "$DOCKER" compose -p pigeonbox --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

case "$1" in
    start)
        if [ ! -f "$ENV_FILE" ]; then
            # 兜底:向导流程未生成时用默认值(理论上 postinst 已生成)
            mkdir -p "$PKGVAR"
            cp "${PKGDEST}/env.example" "$ENV_FILE"
            chmod 600 "$ENV_FILE"
        fi
        DATA_DIR=$(sed -n 's|^FCB_DATA_DIR=||p' "$ENV_FILE" | head -n 1)
        if [ -n "$DATA_DIR" ] && [ "$DATA_DIR" != "/" ]; then
            mkdir -p "$DATA_DIR" 2>/dev/null || true
            chown -R 1000:1000 "$DATA_DIR" 2>/dev/null || true
        fi
        # Container Manager 守护进程偶发未就绪(开机竞态):最多等 30 秒
        i=0
        while ! "$DOCKER" info >/dev/null 2>&1; do
            i=$((i + 1))
            [ "$i" -ge 6 ] && { echo "docker daemon 未就绪(Container Manager 是否已启动?)" >&2; exit 1; }
            sleep 5
        done
        compose up -d >>"$LOG_FILE" 2>&1 || exit 1
        exit 0
        ;;
    stop)
        # 不带 -v:数据在 bind 挂载目录,compose down 本就不删;显式保数据语义
        compose down --remove-orphans >>"$LOG_FILE" 2>&1 || true
        exit 0
        ;;
    status)
        # LSF 语义:0=运行中,3=未运行,4=未知
        out="$("$DOCKER" ps --filter "name=pigeonbox-frontend" --filter "name=pigeonbox-server" --filter "status=running" -q 2>/dev/null)"
        [ -n "$out" ] && exit 0
        exit 3
        ;;
    log)
        echo "$LOG_FILE"
        exit 0
        ;;
esac
exit 1
